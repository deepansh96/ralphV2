{
  "title": "Summary Review",
  "description": "The Answering Agent's faithfulness review of the summary draft. Strict: every property is required; questionId is null when a discrepancy is not about one question.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exchangeId",
    "faithful",
    "discrepancies"
  ],
  "properties": {
    "exchangeId": {
      "type": "string",
      "pattern": "^ex-[0-9]{4,}$"
    },
    "faithful": {
      "type": "boolean"
    },
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "questionId",
          "problem",
          "fix"
        ],
        "properties": {
          "questionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "fix": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
