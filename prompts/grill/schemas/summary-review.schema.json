{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Summary Review",
  "description": "The Answering Agent's faithfulness review of the summary draft.",
  "type": "object",
  "required": ["exchangeId", "faithful", "discrepancies"],
  "properties": {
    "exchangeId": {"type": "string", "pattern": "^ex-[0-9]{4,}$"},
    "faithful": {"type": "boolean"},
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["problem", "fix"],
        "properties": {
          "questionId": {"type": "string"},
          "problem": {"type": "string", "minLength": 1},
          "fix": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
