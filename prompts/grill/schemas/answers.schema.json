{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answers",
  "description": "The Answering Agent's reply to one Frontier round: exactly one answer per question ID in the round, or a needsHuman escalation.",
  "type": "object",
  "required": ["exchangeId"],
  "properties": {
    "exchangeId": {"type": "string", "pattern": "^ex-[0-9]{4,}$"},
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["questionId", "rationale", "evidence"],
        "properties": {
          "questionId": {"type": "string", "minLength": 1},
          "choiceId": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "anyOf": [{"required": ["choiceId"]}, {"required": ["text"]}]
      }
    },
    "needsHuman": {
      "type": "object",
      "required": ["questionIds", "reason"],
      "properties": {
        "questionIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "oneOf": [{"required": ["answers"]}, {"required": ["needsHuman"]}]
}
