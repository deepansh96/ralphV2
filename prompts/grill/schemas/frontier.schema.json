{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontier",
  "description": "One Frontier round from the Grilling Agent. Empty questions and reopens mean the Frontier is empty.",
  "type": "object",
  "required": ["exchangeId", "round", "questions"],
  "properties": {
    "exchangeId": {"type": "string", "pattern": "^ex-[0-9]{4,}$"},
    "round": {"type": "integer", "minimum": 1},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "body", "choices", "recommendation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "body": {"type": "string", "minLength": 1},
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1},
                "description": {"type": "string"}
              }
            }
          },
          "recommendation": {
            "type": "object",
            "required": ["rationale"],
            "properties": {
              "choiceId": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1},
              "rationale": {"type": "string", "minLength": 1}
            },
            "anyOf": [{"required": ["choiceId"]}, {"required": ["text"]}]
          },
          "challenges": {"type": "string"}
        }
      }
    },
    "reopens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["questionId", "contradiction", "evidence"],
        "properties": {
          "questionId": {"type": "string", "minLength": 1},
          "contradiction": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
